# Database (SQLite — use absolute path on your server)
DATABASE_URL="file:/var/www/fitlife/db/production.db"

# NextAuth (when you implement real auth)
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-a-random-32-char-string-here"

# AI Chat SDK (if using z-ai-web-dev-sdk in production)
Z_AI_API_KEY="your-api-key-here"